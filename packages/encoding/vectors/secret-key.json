{
  "description": "Account Secret Key vectors (spec §24): 20 random bytes shown as 32 Crockford Base32 characters in groups of 4 separated by hyphens. Written by hand: the all-zero and all-ones keys are trivially checkable, and the third is the classic Base32 counter pattern whose 5-bit groups are 0,1,2,…,31, so its text is the alphabet itself.",
  "note": "§24 defines no checksum: 20 bytes are exactly 32 × 5 bits, so the 32 characters carry no check symbol. The invalid cases below are therefore length, alphabet and separator failures, not checksum failures. See NOTES question 175.",
  "alphabet": "0123456789ABCDEFGHJKMNPQRSTVWXYZ",
  "canonical": [
    {
      "name": "all-zero key",
      "bytes": "0000000000000000000000000000000000000000",
      "chars": "00000000000000000000000000000000",
      "display": "0000-0000-0000-0000-0000-0000-0000-0000"
    },
    {
      "name": "all-ones key (every 5-bit group is 31 = Z)",
      "bytes": "ffffffffffffffffffffffffffffffffffffffff",
      "chars": "ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ",
      "display": "ZZZZ-ZZZZ-ZZZZ-ZZZZ-ZZZZ-ZZZZ-ZZZZ-ZZZZ"
    },
    {
      "name": "counter pattern: 5-bit groups 0,1,2,…,31, so the text is the alphabet in order",
      "bytes": "00443214c74254b635cf84653a56d7c675be77df",
      "chars": "0123456789ABCDEFGHJKMNPQRSTVWXYZ",
      "display": "0123-4567-89AB-CDEF-GHJK-MNPQ-RSTV-WXYZ"
    },
    {
      "name": "a key where a 5-bit group straddles a byte boundary (bits 125-127 are ones, the next two are zeros, so group 25 is 11100 = W)",
      "bytes": "ffffffffffffffffffffffffffffffff00443214",
      "chars": "ZZZZZZZZZZZZZZZZZZZZZZZZZW048CGM",
      "display": "ZZZZ-ZZZZ-ZZZZ-ZZZZ-ZZZZ-ZZZZ-ZW04-8CGM"
    }
  ],
  "normalization": [
    {
      "name": "lower case",
      "input": "0123-4567-89ab-cdef-ghjk-mnpq-rstv-wxyz",
      "bytes": "00443214c74254b635cf84653a56d7c675be77df"
    },
    {
      "name": "no separators at all",
      "input": "0123456789ABCDEFGHJKMNPQRSTVWXYZ",
      "bytes": "00443214c74254b635cf84653a56d7c675be77df"
    },
    {
      "name": "spaces instead of hyphens",
      "input": "0123 4567 89AB CDEF GHJK MNPQ RSTV WXYZ",
      "bytes": "00443214c74254b635cf84653a56d7c675be77df"
    },
    {
      "name": "ambiguous characters: O -> 0 and I -> 1",
      "input": "OI23-4567-89AB-CDEF-GHJK-MNPQ-RSTV-WXYZ",
      "bytes": "00443214c74254b635cf84653a56d7c675be77df"
    },
    {
      "name": "ambiguous characters: L -> 1",
      "input": "OL23-4567-89AB-CDEF-GHJK-MNPQ-RSTV-WXYZ",
      "bytes": "00443214c74254b635cf84653a56d7c675be77df"
    },
    {
      "name": "lower-case ambiguous characters and erratic spacing",
      "input": "  ol23-4567 89ab--cdef ghjk-mnpq-rstv-wxyz  ",
      "bytes": "00443214c74254b635cf84653a56d7c675be77df"
    }
  ],
  "invalid": [
    { "name": "empty", "input": "", "error": "WRONG_LENGTH" },
    { "name": "separators only", "input": "----", "error": "WRONG_LENGTH" },
    {
      "name": "truncated by one character",
      "input": "0123-4567-89AB-CDEF-GHJK-MNPQ-RSTV-WXY",
